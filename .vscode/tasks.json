{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Flask Dependencies",
      "type": "shell",
      "command": "pip",
      "args": ["install", "-r", "requirements.txt"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Flask Server",
      "type": "shell",
      "command": "python",
      "args": ["app.py"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Test Backend Endpoint",
      "type": "shell",
      "command": "curl",
      "args": ["-X", "POST", "http://localhost:5000/check_news", "-H", "Content-Type: application/json", "-d", "{\"text\": \"Sample news article for testing.\"}"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Open Frontend in Browser",
      "type": "shell",
      "command": "start",
      "args": ["index.html"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}