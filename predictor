# 3. Clean and Predict
def check_news(text):
    # Convert text into numbers the computer understands
    transformed_text = vectorizer.transform([text])
    # Predict: 0 for Fake, 1 for Real
    prediction = model.predict(transformed_text)
    return "REAL" if prediction == 1 else "FAKE"

